modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "packaging-concurrency"

[[workflows.workflow]]
name = "packaging-concurrency"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm test:packaging-concurrency"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["clamav"]

[userenv]

[userenv.shared]
QUALITY_NOTIFICATION_RECIPIENT = "hmouzrazan@gmail.com"
RESEND_FROM_EMAIL = "onboarding@resend.dev"
